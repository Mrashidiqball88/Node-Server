run = "cd artifacts/mockup-sandbox && npm run dev"
modules = ["nodejs-24"]

[[ports]]
localPort = 3000
externalPort = 3001

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3000

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Ride-Hailing App"

[[workflows.workflow]]
name = "Ride-Hailing App"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd ride-hailing && node server.js"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "console"
